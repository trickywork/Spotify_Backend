{
  "info": {
    "name": "Spotify Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Feed",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/feed"
      }
    },
    {
      "name": "Playlists",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/playlists"
      }
    },
    {
      "name": "Playlist 1",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/playlist/1"
      }
    }
  ]
}
